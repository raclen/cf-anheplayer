---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** 站点图标路径；AnhePlayer 宣传页传入播放器图标 */
  favicon?: string;
  /** 手机访问时自动跳转到 /mobile（仅 PC 首页使用） */
  redirectMobile?: boolean;
}

const {
  title = "AnhePlayer · 支持洛雪插件的免费音乐播放器",
  description = "AnhePlayer 是一款基于 Tauri v2 打造的轻量 Windows 桌面音乐播放器。支持洛雪插件、本地曲库、网易云私人推荐与主题定制，无广告、不上传个人数据。",
  favicon = "/favicon.svg",
  redirectMobile = false,
} = Astro.props;

const faviconType = favicon.endsWith(".svg") ? "image/svg+xml" : "image/png";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const ogImage = Astro.site
  ? new URL("/og-image.png", Astro.site).href
  : "/og-image.png";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirectMobile && (
      <script is:inline>
        // 手机访问 PC 首页时引导到移动端页面；放在 head 中尽早执行，避免先闪一下桌面版
        (function () {
          try {
            var KEY = "anhe-view";
            var params = new URLSearchParams(window.location.search);

            // 手动切换：?desktop=1 强制看桌面版，?mobile=1 恢复自动跳转
            if (params.has("desktop")) localStorage.setItem(KEY, "desktop");
            else if (params.has("mobile")) localStorage.removeItem(KEY);
            if (localStorage.getItem(KEY) === "desktop") return;

            var ua = navigator.userAgent || "";
            // 搜索引擎爬虫不跳转，避免移动优先索引把首页收录成移动版
            if (/bot|crawler|spider|crawling|googlebot|bingbot|baiduspider|yandex/i.test(ua)) return;

            var isPhone = /Android|iPhone|iPod|Mobile|HarmonyOS|Windows Phone|BlackBerry|Kindle|Silk/i.test(ua);
            // iPadOS 13+ 的 UA 与 macOS 相同，用触点数区分
            var isIPad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
            // 触屏且窄屏（平板竖屏、折叠屏内屏）也归入移动端
            var isTouchNarrow =
              window.matchMedia("(pointer: coarse)").matches &&
              window.matchMedia("(max-width: 820px)").matches;

            if (isPhone || isIPad || isTouchNarrow) {
              window.location.replace("/mobile");
            }
          } catch (e) {
            // localStorage 在隐私模式下可能抛错，按桌面版正常展示即可
          }
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type={faviconType} href={favicon} />
    <meta name="theme-color" content="#070b16" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="AnhePlayer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Cloudflare Web Analytics：域名未托管在 CF，需手动挂载 beacon -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "79296de368e04cd38a199ff0f0ba7533"}'
    ></script>
  </head>
  <body>
    <slot />

    <!-- 滚动淡入：为 .reveal 元素添加 is-visible -->
    <script>
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
