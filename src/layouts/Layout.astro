---
import "../styles/global.css";
import { GITHUB_REPO_URL as PC_REPO_URL } from "@/data/platforms";
import { MOBILE_REPO_URL } from "@/data/mobile";
import { DOWNLOADER_REPO_URL } from "@/data/downloader";
import { absoluteUrl, siteBaseUrl } from "@/utils/url";

export interface Props {
  title?: string;
  description?: string;
  /** 关键词（Google 已忽略，仍会被部分中文搜索引擎读取） */
  keywords?: string;
  /** 站点图标路径；AnhePlayer 宣传页传入播放器图标 */
  favicon?: string;
  /** 手机访问时自动跳转到 /mobile（仅 PC 首页使用） */
  redirectMobile?: boolean;
  /** 社交分享图，默认站点通用图；用于微信 / Telegram / X 等平台的卡片预览 */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** 页面级 JSON-LD（Schema.org），可传单个对象或数组 */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 面包屑结构化数据；数组顺序为从首页到当前页（首页无需包含） */
  breadcrumbs?: { name: string; path: string }[];
  /** 无需收录的页面（如 404）置为 true */
  noIndex?: boolean;
}

const {
  title = "AnhePlayer 安禾播放器 · 支持洛雪插件的开源音乐播放器",
  description = "AnhePlayer 是一款基于 Tauri v2 打造的轻量 Windows 桌面音乐播放器。支持洛雪插件、本地曲库、网易云私人推荐与主题定制，无广告、不上传个人数据。",
  keywords = "AnhePlayer, 安禾播放器, 洛雪音乐, 洛雪音源, 开源音乐播放器, 免费音乐播放器, Windows 音乐播放器",
  favicon = "/logo.png",
  redirectMobile = false,
  ogImage = "/og-image.png",
  ogImageAlt = "AnhePlayer 安禾播放器 · 支持洛雪插件的开源音乐播放器",
  ogType = "website",
  jsonLd,
  breadcrumbs,
  noIndex = false,
} = Astro.props;

const FAILOVER_FAVICON_TYPES: Record<string, string> = {
  svg: "image/svg+xml",
  png: "image/png",
  webp: "image/webp",
  ico: "image/x-icon",
};
const faviconType =
  FAILOVER_FAVICON_TYPES[(favicon.split(".").pop() || "png").toLowerCase()] || "image/png";

const siteBase = siteBaseUrl(Astro.site);
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const ogImageUrl = absoluteUrl(Astro.site, ogImage);

// 站点级结构化数据：Organization + WebSite，各页面通过 @id 引用
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteBase}#organization`,
  name: "AnhePlayer",
  alternateName: ["安禾播放器", "安禾播放器系列"],
  url: siteBase,
  logo: absoluteUrl(Astro.site, "/logo.png"),
  description:
    "AnhePlayer（安禾播放器）是一套开源、免费、无广告的音乐软件系列，包含 Windows 桌面播放器、Android 移动端播放器、轻量音乐下载器与洛雪音源可用性监测。",
  sameAs: [PC_REPO_URL, MOBILE_REPO_URL, DOWNLOADER_REPO_URL, "https://github.com/raclen/cf-anheplayer"],
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteBase}#website`,
  url: siteBase,
  name: "AnhePlayer 安禾播放器",
  alternateName: "安禾播放器官方下载站",
  inLanguage: "zh-CN",
  publisher: { "@id": `${siteBase}#organization` },
};

const pageLdList = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

// 面包屑：首页 → 各产品页，帮助搜索引擎展示层级路径
const breadcrumbLd =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [{ name: "首页", path: "/" }, ...breadcrumbs].map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: absoluteUrl(Astro.site, item.path),
        })),
      }
    : null;

if (breadcrumbLd) pageLdList.push(breadcrumbLd);

// 序列化时转义 <，防止音源标题等外部文案破坏 script 标签
const toJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirectMobile && (
      <script is:inline>
        // 手机访问 PC 首页时引导到移动端页面；放在 head 中尽早执行，避免先闪一下桌面版
        (function () {
          // 1. 彻底清除旧版本遗留在 localStorage 的持久化状态（防止此前点过桌面版的用户手机被永久锁死在 PC 首页）
          try {
            localStorage.removeItem("anhe-view");
          } catch (_) {}

          // 2. 检查本次会话是否由用户主动指定查看桌面版
          var search = window.location.search || "";
          var hasDesktopParam = /[?&]desktop(=|&|$)/i.test(search);
          var hasMobileParam = /[?&]mobile(=|&|$)/i.test(search);

          if (hasDesktopParam) {
            try { sessionStorage.setItem("anhe-view-desktop", "1"); } catch (_) {}
            return;
          }
          if (hasMobileParam) {
            try { sessionStorage.removeItem("anhe-view-desktop"); } catch (_) {}
          } else {
            try {
              if (sessionStorage.getItem("anhe-view-desktop") === "1") return;
            } catch (_) {}
          }

          // 3. 搜索引擎爬虫/机器人豁免跳转，避免移动优先索引把首页收录成移动版
          var ua = (navigator.userAgent || "") + " " + (navigator.appVersion || "");
          if (/bot|crawler|spider|crawling|googlebot|bingbot|baiduspider|yandex/i.test(ua)) return;

          // 4. 多重移动端特征识别
          // A. 常见移动系统/设备 UA 关键词（含 Android、iOS、HarmonyOS、纯血鸿蒙 OpenHarmony、独立 Phone 标识等）
          var isMobileUA = /(?:Android|iPhone|iPod|Mobile|HarmonyOS|OpenHarmony|\bPhone\b|Windows Phone|BlackBerry|Kindle|Silk|webOS|Opera Mini)/i.test(ua);

          // B. 现代 Chromium Client Hints (Android Chrome, Edge, 夸克等)
          var isMobileData = !!(navigator.userAgentData && navigator.userAgentData.mobile);

          // C. iPadOS 13+ (macOS UA + 触控点 > 1)
          var isIPad = /Macintosh/.test(ua) && (navigator.maxTouchPoints > 1);

          // D. 触屏设备且属于移动端屏幕尺寸（折叠屏、竖屏平板、各品牌手机 Webview）
          var screenDim = (window.screen && Math.min(window.screen.width, window.screen.height)) || 0;
          var isTouchScreen = (navigator.maxTouchPoints > 0) || (window.matchMedia && (window.matchMedia("(pointer: coarse)").matches || window.matchMedia("(any-pointer: coarse)").matches));
          var isTouchNarrow = isTouchScreen && (screenDim > 0 ? screenDim <= 820 : (window.innerWidth && window.innerWidth <= 820));

          if (isMobileUA || isMobileData || isIPad || isTouchNarrow) {
            var searchParams = new URLSearchParams(search);
            searchParams.delete("desktop");
            var qs = searchParams.toString();
            var target = "/mobile/" + (qs ? "?" + qs : "") + (window.location.hash || "");
            window.location.replace(target);
          }
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    {!noIndex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type={faviconType} href={favicon} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#070b16" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="AnhePlayer 安禾播放器" />
    <!-- Google Search Console 站点所有权验证（用于提交 sitemap，勿删除） -->
    <meta name="google-site-verification" content="EmVeVgk0PYS3tWUTT1tcWgqNn3hZKDCAiIrd6ysZgaI" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="AnhePlayer 安禾播放器" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- 结构化数据：站点级 Organization / WebSite + 页面级内容 -->
    <script type="application/ld+json" is:inline set:html={toJsonLd(organizationLd)} />
    <script type="application/ld+json" is:inline set:html={toJsonLd(websiteLd)} />
    {pageLdList.map((ld) => (
      <script type="application/ld+json" is:inline set:html={toJsonLd(ld)} />
    ))}

    <!-- 禁用 JS 时取消滚动淡入的初始隐藏，保证内容始终可读、可被抓取 -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important}</style></noscript>

    <!-- Cloudflare Web Analytics：域名未托管在 CF，需手动挂载 beacon -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "79296de368e04cd38a199ff0f0ba7533"}'
    ></script>
  </head>
  <body>
    <slot />

    <!-- 滚动淡入：为 .reveal 元素添加 is-visible -->
    <script>
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
