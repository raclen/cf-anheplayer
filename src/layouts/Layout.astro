---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  /** 站点图标路径；AnhePlayer 宣传页传入播放器图标 */
  favicon?: string;
  /** 手机访问时自动跳转到 /mobile（仅 PC 首页使用） */
  redirectMobile?: boolean;
}

const {
  title = "AnhePlayer · 支持洛雪插件的免费音乐播放器",
  description = "AnhePlayer 是一款基于 Tauri v2 打造的轻量 Windows 桌面音乐播放器。支持洛雪插件、本地曲库、网易云私人推荐与主题定制，无广告、不上传个人数据。",
  favicon = "/favicon.svg",
  redirectMobile = false,
} = Astro.props;

const faviconType = favicon.endsWith(".svg") ? "image/svg+xml" : "image/png";

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const ogImage = Astro.site
  ? new URL("/og-image.png", Astro.site).href
  : "/og-image.png";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {redirectMobile && (
      <script is:inline>
        // 手机访问 PC 首页时引导到移动端页面；放在 head 中尽早执行，避免先闪一下桌面版
        (function () {
          // 1. 彻底清除旧版本遗留在 localStorage 的持久化状态（防止此前点过桌面版的用户手机被永久锁死在 PC 首页）
          try {
            localStorage.removeItem("anhe-view");
          } catch (_) {}

          // 2. 检查本次会话是否由用户主动指定查看桌面版
          var search = window.location.search || "";
          var hasDesktopParam = /[?&]desktop(=|&|$)/i.test(search);
          var hasMobileParam = /[?&]mobile(=|&|$)/i.test(search);

          if (hasDesktopParam) {
            try { sessionStorage.setItem("anhe-view-desktop", "1"); } catch (_) {}
            return;
          }
          if (hasMobileParam) {
            try { sessionStorage.removeItem("anhe-view-desktop"); } catch (_) {}
          } else {
            try {
              if (sessionStorage.getItem("anhe-view-desktop") === "1") return;
            } catch (_) {}
          }

          // 3. 搜索引擎爬虫/机器人豁免跳转，避免移动优先索引把首页收录成移动版
          var ua = (navigator.userAgent || "") + " " + (navigator.appVersion || "");
          if (/bot|crawler|spider|crawling|googlebot|bingbot|baiduspider|yandex/i.test(ua)) return;

          // 4. 多重移动端特征识别
          // A. 常见移动系统/设备 UA 关键词（含 Android、iOS、HarmonyOS、纯血鸿蒙 OpenHarmony、独立 Phone 标识等）
          var isMobileUA = /(?:Android|iPhone|iPod|Mobile|HarmonyOS|OpenHarmony|\bPhone\b|Windows Phone|BlackBerry|Kindle|Silk|webOS|Opera Mini)/i.test(ua);

          // B. 现代 Chromium Client Hints (Android Chrome, Edge, 夸克等)
          var isMobileData = !!(navigator.userAgentData && navigator.userAgentData.mobile);

          // C. iPadOS 13+ (macOS UA + 触控点 > 1)
          var isIPad = /Macintosh/.test(ua) && (navigator.maxTouchPoints > 1);

          // D. 触屏设备且属于移动端屏幕尺寸（折叠屏、竖屏平板、各品牌手机 Webview）
          var screenDim = (window.screen && Math.min(window.screen.width, window.screen.height)) || 0;
          var isTouchScreen = (navigator.maxTouchPoints > 0) || (window.matchMedia && (window.matchMedia("(pointer: coarse)").matches || window.matchMedia("(any-pointer: coarse)").matches));
          var isTouchNarrow = isTouchScreen && (screenDim > 0 ? screenDim <= 820 : (window.innerWidth && window.innerWidth <= 820));

          if (isMobileUA || isMobileData || isIPad || isTouchNarrow) {
            var searchParams = new URLSearchParams(search);
            searchParams.delete("desktop");
            var qs = searchParams.toString();
            var target = "/mobile/" + (qs ? "?" + qs : "") + (window.location.hash || "");
            window.location.replace(target);
          }
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type={faviconType} href={favicon} />
    <meta name="theme-color" content="#070b16" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="AnhePlayer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Cloudflare Web Analytics：域名未托管在 CF，需手动挂载 beacon -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "79296de368e04cd38a199ff0f0ba7533"}'
    ></script>
  </head>
  <body>
    <slot />

    <!-- 滚动淡入：为 .reveal 元素添加 is-visible -->
    <script>
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
