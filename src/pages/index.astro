---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Features from "@/components/Features.astro";
import Screenshots from "@/components/Screenshots.astro";
import Download from "@/components/Download.astro";
import PluginsThemes from "@/components/PluginsThemes.astro";
import FamilySection from "@/components/FamilySection.astro";
import Footer from "@/components/Footer.astro";
import Faq from "@/components/Faq.astro";
import { GITHUB_REPO_URL, GITHUB_REPO, RELEASES_URL } from "@/data/platforms";
import { getPcRelease } from "@/data/releases";
import { absoluteUrl } from "@/utils/url";
import { buildFaqLd } from "@/utils/seo";
import { PC_FAQ } from "@/data/faq";

const pc = getPcRelease();

// PC 桌面端软件应用结构化数据：下载页最容易被识别为「软件下载」结果
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "AnhePlayer 安禾播放器",
  alternateName: ["安禾播放器", "AnhePlayer PC 端"],
  applicationCategory: "MultimediaApplication",
  applicationSubCategory: "音乐播放器",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: pc.version,
  downloadUrl: absoluteUrl(Astro.site, "/#download"),
  installUrl: absoluteUrl(Astro.site, "/#download"),
  fileSize: pc.setupAsset?.formattedSize,
  datePublished: pc.publishedAt,
  inLanguage: "zh-CN",
  isAccessibleForFree: true,
  license: GITHUB_REPO_URL,
  codeRepository: GITHUB_REPO_URL,
  releaseNotes: `${RELEASES_URL}/tag/${pc.tag}`,
  description:
    "基于 Tauri v2 原生引擎的 Windows 桌面音乐播放器，支持洛雪插件音源、本地曲库管理、网易云私人推荐与主题定制，开源免费、无广告、不上传个人数据。",
  featureList: [
    "洛雪插件音源与远程订阅",
    "本地曲库与歌词封面管理",
    "网易云私人雷达与每日推荐",
    "播放队列与多音质切换",
    "主题市场与 .mftheme 主题包",
    "WebDAV 备份与数据迁移",
  ],
  screenshot: absoluteUrl(Astro.site, "/promo/pc-home.webp"),
  offers: { "@type": "Offer", price: "0", priceCurrency: "CNY" },
  publisher: { "@id": `${absoluteUrl(Astro.site, "/")}#organization` },
};

const faqItems = PC_FAQ;
const faqLd = buildFaqLd(faqItems);
---

<Layout
  favicon="/logo.png"
  redirectMobile
  title="AnhePlayer 安禾播放器 · 支持洛雪插件的开源免费音乐播放器下载"
  description="AnhePlayer 安禾播放器是基于 Tauri v2 打造的轻量 Windows 桌面音乐播放器，支持洛雪插件音源、本地曲库管理、网易云私人雷达与主题定制，开源免费、无广告、不上传个人数据。"
  keywords="AnhePlayer, 安禾播放器, 洛雪音乐, 洛雪音源, 洛雪插件, 开源音乐播放器, Windows 音乐播放器, 免费音乐播放器下载, 网易云私人雷达"
  ogImage="/og/pc.png"
  ogImageAlt="AnhePlayer 安禾播放器 PC 桌面端"
  jsonLd={[softwareLd, faqLd]}
>
  <Nav current="pc" />
  <main>
    <Hero />
    <Features />
    <Screenshots />
    <Download />
    <PluginsThemes />
    <Faq items={faqItems} title="关于 AnhePlayer 的常见问题" />
    <FamilySection />
  </main>
  <Footer />
</Layout>
