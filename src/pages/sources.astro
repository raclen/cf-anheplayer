---
import fs from "node:fs";
import path from "node:path";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Faq from "@/components/Faq.astro";
import { absoluteUrl } from "@/utils/url";
import { buildFaqLd } from "@/utils/seo";
import { SOURCES_FAQ } from "@/data/faq";
import { buildMergedSources } from "../../scripts/lib/merged-sources.mjs";

const statusFile = path.resolve(process.cwd(), "src/data/sources-status.json");
let status: any = null;
try {
  status = JSON.parse(fs.readFileSync(statusFile, "utf8"));
} catch {
  status = null;
}

const statusMeta: Record<string, { label: string; tone: string }> = {
  available: { label: "可用", tone: "ok" },
  partial: { label: "部分可用", tone: "warn" },
  unavailable: { label: "检测未通过", tone: "bad" },
  untested: { label: "未检测", tone: "idle" },
};

// 部分可用与可用合并展示，组内顺序：完全可用 → 部分可用
const statusRank: Record<string, number> = { unavailable: 0, untested: 1, partial: 2, available: 3 };
// 页面默认按「可用」筛选，部分可用也计入可用
const isAvailableLike = (s: string) => s === "available" || s === "partial";
const categoryRank: Record<string, number> = { 优质: 0, 一般: 1, 在线: 2 };

const sources: any[] = Array.isArray(status?.sources)
  ? [...status.sources].sort(
      (a, b) =>
        (statusRank[a.status] ?? 9) - (statusRank[b.status] ?? 9) ||
        (categoryRank[a.category] ?? 9) - (categoryRank[b.category] ?? 9) ||
        String(a.title).localeCompare(String(b.title), "zh-CN"),
    )
  : [];

const summary = status?.summary ?? {
  total: 0,
  available: 0,
  partial: 0,
  unavailable: 0,
  untested: 0,
  platformsOk: 0,
  platformsTested: 0,
};

const passRate = summary.platformsTested
  ? Math.round((summary.platformsOk / summary.platformsTested) * 100)
  : 0;

const fmt = (iso?: string | null) => {
  if (!iso) return "—";
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "—";
  return new Intl.DateTimeFormat("zh-CN", {
    timeZone: "Asia/Shanghai",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).format(date);
};

const fmtFull = (iso?: string | null) => {
  if (!iso) return "—";
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return "—";
  return new Intl.DateTimeFormat("zh-CN", {
    timeZone: "Asia/Shanghai",
    dateStyle: "medium",
    timeStyle: "short",
    hour12: false,
  }).format(date);
};

const fmtMs = (ms?: number | null) => {
  if (ms == null) return "—";
  return ms >= 1000 ? `${(ms / 1000).toFixed(1)}s` : `${Math.round(ms)}ms`;
};

// 复制/下载使用的音源地址：统一走本站域名。
// 构建前由 scripts/lib/prepare-sources.mjs 把本地音源与在线音源落到 public/sources/，
// 避免 raw.githubusercontent.com 在部分地区无法直连。
const REPO_RAW_BASE = "https://raw.githubusercontent.com/raclen/cf-anheplayer/main";
const encodeRepoPath = (file: string) => file.split("/").map(encodeURIComponent).join("/");
const publicExists = (rel: string) => fs.existsSync(path.resolve(process.cwd(), "public", ...rel.split("/")));

// 在线音源清单：构建时下载失败时用于回退到镜像地址
let remoteList: any[] = [];
try {
  remoteList = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "sources/remote.json"), "utf8"));
} catch {
  remoteList = [];
}
const remoteById = new Map<string, any>((Array.isArray(remoteList) ? remoteList : []).map((r: any) => [r.id, r]));

const resolveSourceUrl = (src: any) => {
  if (!src.remote) {
    if (!src.file) return "";
    // 对外文件名用 ASCII id（sha1 前 10 位），规避中文/空格/括号路径的编码兼容问题
    if (src.id && publicExists(`sources/${src.id}.js`)) return `/sources/${encodeURIComponent(src.id)}.js`;
    // 兜底：构建产物里没有时仍指向仓库原文
    return `${REPO_RAW_BASE}/sources/${encodeRepoPath(src.file)}`;
  }
  const remoteId = String(src.id || "").replace(/^remote-/, "");
  if (remoteId && publicExists(`sources/remote/${remoteId}.js`)) {
    return `/sources/remote/${encodeURIComponent(remoteId)}.js`;
  }
  const meta = remoteById.get(remoteId);
  return meta?.mirror || meta?.url || src.originUrl || src.sourceUrl || "";
};

// 下载按钮使用的文件名：本地音源用原文件名，在线音源用音源标题（原始链接多为 latest.js，不可读）
const resolveDownloadName = (src: any) => {
  if (!src.remote && src.file) return src.file.split("/").pop() || "source.js";
  const safeTitle = String(src.title || src.name || "音源").replace(/[\\/:*?"<>|]/g, "_").trim();
  return `${safeTitle || "source"}.js`;
};

// 合并音源清单：与 scripts/build-merged-sources.mjs 用同一份纯函数，
// 构建期直接由最新检测结果算出，页面数字与 public/merged-sources.json 一致。
const merged = buildMergedSources(status, remoteList);
const mergedJsonUrl = absoluteUrl(Astro.site, "/merged-sources.json");
const mergedTxtUrl = absoluteUrl(Astro.site, "/merged-sources.txt");

// 音源清单结构化数据：让搜索引擎理解这是一份持续更新的可用音源目录
const sourceItems = sources.filter((s) => isAvailableLike(s.status)).slice(0, 30);
const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "洛雪音源可用性清单",
  numberOfItems: summary.total,
  itemListElement: sourceItems.map((src, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: src.title,
    url: absoluteUrl(Astro.site, "/sources/"),
    description: [
      `状态：${statusMeta[src.status]?.label ?? src.status}`,
      src.author ? `作者：${src.author}` : "",
      `通过 ${src.stats?.ok ?? 0}/${src.stats?.tested ?? 0} 个平台`,
    ]
      .filter(Boolean)
      .join(" · "),
  })),
};

const faqItems = SOURCES_FAQ;
const faqLd = buildFaqLd(faqItems);
---

<Layout
  title="洛雪音源状态监测 · 实时音源可用性检测 · AnhePlayer 安禾播放器"
  description="每 4 小时自动检测洛雪音乐自定义音源的可用性，展示每个音源在网易云、QQ 音乐、酷我、酷狗、咪咕等平台的拉流状态，并提供可随时复制的 .js 音源链接与公开 JSON 接口。"
  keywords="洛雪音源, 洛雪音乐音源, 音源检测, 音源可用性, 洛雪音源列表, 自定义音源 js, 音乐音源监测"
  ogImage="/og/sources.png"
  ogImageAlt="洛雪音源可用性实时监测"
  jsonLd={[itemListLd, faqLd]}
  breadcrumbs={[{ name: "洛雪音源状态监测", path: "/sources/" }]}
>
  <Nav current="sources" downloadHref="" githubUrl="https://github.com/raclen/cf-anheplayer" />

  <main>
    <section class="status-hero">
      <div class="container">
        <span class="eyebrow">LX MUSIC · SOURCE MONITOR</span>
        <h1>洛雪音源<br />状态监测</h1>
        <p class="hero-desc">
          每 4 小时自动加载互联网上收集的音源，完成初始化后依次请求测试歌曲，并校验返回的播放地址能否真实拉流。
        </p>
        <div class="hero-meta">
          <span class="pulse" aria-hidden="true"></span>
          <span>最后检测 <b>{fmtFull(status?.generatedAt)}</b></span>
          <span class="meta-sep">/</span>
          <span>下次预计 <b>{fmtFull(status?.nextCheckAt)}</b></span>
        </div>
      </div>
    </section>

    <section class="container status-overview" id="overview" aria-label="检测概览">
      <article class="stat stat-total">
        <span class="stat-value">{summary.total}</span>
        <span class="stat-label">音源总数</span>
      </article>
      <article class="stat stat-ok">
        <span class="stat-value">{summary.available}</span>
        <span class="stat-label">完全可用</span>
      </article>
      <article class="stat stat-warn">
        <span class="stat-value">{summary.partial}</span>
        <span class="stat-label">部分可用</span>
      </article>
      <article class="stat stat-bad">
        <span class="stat-value">{summary.unavailable}</span>
        <span class="stat-label">检测未通过</span>
      </article>
      <article class="stat stat-rate">
        <span class="stat-value">{passRate}<small>%</small></span>
        <span class="stat-label">平台通过率 · {summary.platformsOk}/{summary.platformsTested}</span>
      </article>
    </section>

    <section class="container status-meta-row" aria-label="检测信息">
      <div><span>检测耗时</span><b>{fmtMs(status?.durationMs)}</b></div>
      <div><span>检测间隔</span><b>{status?.intervalHours ?? 4} 小时</b></div>
      <div class="meta-note">
        <span>判定规则</span>
        <b>初始化成功 + 至少一个平台能拉到音频</b>
      </div>
    </section>

    <!-- 机制说明与版权免责提示 -->
    <section class="container status-notice" aria-label="检测参考说明">
      <div class="notice-card">
        <svg class="notice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <p class="notice-text">
          <b>检测说明：</b>本站只检测音源自身接口，不包含播放器的内置解析或跨音源兜底。因此，“检测未通过”不等于播放器无法播放。固定歌曲的版权、VIP 权限及加密流（如 <code>.mgg</code>）也会影响结果，请以客户端实际试听为准。
        </p>
      </div>
    </section>

    <!-- 合并音源：通过检测的音源去重后的订阅清单与链接列表 -->
    <section class="container panel merged-panel" id="merged-sources" aria-label="合并音源">
      <div class="panel-head">
        <div>
          <h2>合并音源</h2>
          <p class="panel-desc">
            本轮检测通过 {merged.totalPassing} 个，去重后保留 <b>{merged.included}</b> 个
            （去掉 {merged.removedDuplicates.length} 个同名重复），按通过平台数排序。
            {status?.generatedAt ? `检测时间 ${fmtFull(status.generatedAt)}。` : ""}
          </p>
        </div>
        <span class="tag tag-ok">随检测自动更新</span>
      </div>
      <p class="panel-note">
        这不是把多个 .js 脚本拼成一个文件——洛雪一个脚本只能注册一个音源，拼接会互相覆盖。
        合并清单是“一次拿走全部可用音源”的订阅与链接列表：逐个导入后开启播放失败自动换源，
        播放器会在多个音源之间兜底，这才是运行时的合并。
      </p>
      <div class="panel-actions">
        <button class="action-btn action-btn-primary" id="copy-merged-json" type="button" data-copy-url={mergedJsonUrl}>复制订阅地址</button>
        <button class="action-btn" id="copy-merged-links" type="button">复制全部链接</button>
        <a class="action-btn" href={mergedJsonUrl} download="merged-sources.json">下载合并清单（JSON）</a>
        <a class="action-btn" href={mergedTxtUrl} download="merged-sources.txt">下载链接列表（TXT）</a>
      </div>
      <p class="panel-status" id="merged-status" role="status" aria-live="polite"></p>
      <details class="merged-details">
        <summary>查看合并清单里的 {merged.included} 个音源</summary>
        <ol class="merged-list">
          {merged.sources.map((src) => (
            <li>
              <a href={src.path} target="_blank" rel="noopener">{src.title}</a>
              <span class="merged-meta">{src.passed} 平台{src.version ? ` · v${String(src.version).replace(/^v/i, "")}` : ""}</span>
            </li>
          ))}
        </ol>
        {merged.removedDuplicates.length > 0 && (
          <p class="panel-note">
            去掉的同名重复：{merged.removedDuplicates.map((item) => `${item.name} v${String(item.version).replace(/^v/i, "")}`).join("、")}。
            保留项的理由见仓库 scripts/lib/merged-sources.mjs。
          </p>
        )}
      </details>
    </section>

    <!-- 自定义添加音源：只保存在本机浏览器，不会同步给其他人 -->
    <section class="container panel custom-panel" id="custom-sources" aria-label="自定义添加音源">
      <div class="panel-head">
        <div>
          <h2>自定义添加音源</h2>
          <p class="panel-desc">加一个本站清单里没有的洛雪 .js 音源链接，只保存在这台设备的浏览器里。</p>
        </div>
        <span class="tag tag-version">仅本机保存</span>
      </div>
      <form class="custom-form" id="custom-source-form" novalidate>
        <label class="field">
          <span>音源名称 *</span>
          <input id="custom-name" type="text" maxlength="60" placeholder="例如：我的聚合音源" autocomplete="off" required />
        </label>
        <label class="field field-wide">
          <span>音源链接（.js）*</span>
          <input id="custom-url" type="url" inputmode="url" placeholder="https://example.com/source.js" autocomplete="off" required />
        </label>
        <label class="field">
          <span>镜像链接（可选）</span>
          <input id="custom-mirror" type="url" inputmode="url" placeholder="https://example.com/mirror.js" autocomplete="off" />
        </label>
        <label class="field">
          <span>主页（可选）</span>
          <input id="custom-homepage" type="url" inputmode="url" placeholder="https://example.com" autocomplete="off" />
        </label>
        <div class="panel-actions">
          <button class="action-btn action-btn-primary" id="custom-add-btn" type="submit">检测链接并添加</button>
          <span class="panel-status" id="custom-status" role="status" aria-live="polite"></span>
        </div>
      </form>
      <p class="panel-note">
        添加时只做链接可达性检查（能打开、内容疑似脚本），不执行脚本代码，也不做沙箱拉流检测，
        “可达”不等于“可用”。想让它进入本站的 4 小时检测与所有人可见的清单，请用下面的方式提交给维护者。
      </p>
      <div id="custom-list" class="custom-list" aria-live="polite"></div>
      <div class="panel-actions">
        <button class="action-btn" id="copy-combined-links" type="button">复制合并清单 + 我的音源</button>
        <button class="action-btn" id="download-custom-json" type="button">下载我的音源清单（JSON）</button>
        <button class="action-btn" id="copy-submit-snippet" type="button">复制提交片段（remote.json）</button>
        <a class="action-btn" id="submit-issue-link" href="https://github.com/raclen/cf-anheplayer/issues/new" target="_blank" rel="noopener">提交到 GitHub Issue</a>
      </div>
    </section>

    <section class="container status-toolbar" aria-label="筛选">
      <label class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="search-input" type="search" placeholder="搜索音源名称、作者或平台…" autocomplete="off" />
      </label>

      <div class="filter-group" role="group" aria-label="按状态筛选">
        <button class="filter-chip is-active" data-filter-status="available" type="button">可用</button>
        <button class="filter-chip" data-filter-status="unavailable" type="button">检测未通过</button>
      </div>

      <span class="result-count">显示 <b id="result-count">{sources.filter((s) => isAvailableLike(s.status)).length}</b> 条</span>
    </section>

    <section class="container status-list" id="sources-list" aria-live="polite">
      {sources.length === 0 && (
        <div class="empty-state">
          <h2>还没有检测数据</h2>
          <p>运行 <code>node scripts/check-sources.mjs</code> 生成首份结果，或等待 GitHub Actions 完成第一次定时检测。</p>
        </div>
      )}

      {sources.map((src) => {
        const meta = statusMeta[src.status] ?? statusMeta.untested;
        const failed = (src.platforms || []).filter((p: any) => p.tested && !p.ok);
        const searchText = [
          src.title,
          src.name,
          src.author,
          src.description,
          src.category,
          ...(src.platforms || []).map((p: any) => `${p.name} ${p.key}`),
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();
        return (
          <article
            class={`src-card tone-${meta.tone}`}
            data-status={src.status}
            data-search={searchText}
            hidden={!isAvailableLike(src.status)}
          >
            <div class="src-head">
              <span class="src-dot" aria-hidden="true"></span>
              <div class="src-title-wrap">
                <h2 class="src-title">{src.title}</h2>
                <div class="src-tags">
                  <span class={`tag tag-${meta.tone}`}>{meta.label}</span>
                  {src.version && <span class="tag tag-version">v{String(src.version).replace(/^v/i, "")}</span>}
                  {src.author && <span class="src-author">by {src.author}</span>}
                  {src.remote && src.sourceUrl && (
                    <a class="src-link" href={src.sourceUrl} target="_blank" rel="noopener">源脚本 ↗</a>
                  )}
                </div>
              </div>
              <div class="src-actions">
                <button
                  class="icon-btn copy-btn"
                  type="button"
                  data-source-path={resolveSourceUrl(src)}
                  aria-label="复制音源链接"
                  title="复制音源链接"
                >
                  <svg class="icon-default" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <rect x="9" y="9" width="11" height="11" rx="2"></rect>
                    <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                  </svg>
                  <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m5 12 5 5L20 7"></path>
                  </svg>
                </button>
                <a
                  class="icon-btn download-btn"
                  href={resolveSourceUrl(src)}
                  data-download-name={resolveDownloadName(src)}
                  download={resolveDownloadName(src)}
                  target="_blank"
                  rel="noopener"
                  aria-label="下载音源脚本"
                  title="下载音源脚本"
                >
                  <svg class="icon-default" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M12 4v10"></path>
                    <path d="m7.5 10 4.5 4.5L16.5 10"></path>
                    <path d="M4.5 19.5h15"></path>
                  </svg>
                  <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m5 12 5 5L20 7"></path>
                  </svg>
                </a>
                <div class="src-score" title="通过平台数 / 已测平台数">
                  <b>{src.stats?.ok ?? 0}</b><span>/{src.stats?.tested ?? 0}</span>
                </div>
              </div>
            </div>

            {src.description && <p class="src-desc">{src.description}</p>}

            <div class="platform-pills">
              {(src.platforms || []).map((p: any) => (
                <span
                  class={`pill ${p.ok ? "is-ok" : p.tested ? "is-fail" : "is-idle"}`}
                  title={
                    p.ok
                      ? `${p.name} · ${p.quality || "128k"} · ${fmtMs(p.ms)}${p.urlHost ? ` · ${p.urlHost}` : ""}`
                      : p.tested
                        ? `${p.name} · ${p.error || "请求失败"}`
                        : `${p.name} · 未纳入自动检测`
                  }
                >
                  <i aria-hidden="true"></i>
                  {p.name}
                  <em>{p.tested ? (p.ok ? fmtMs(p.ms) : "失败") : "未测"}</em>
                </span>
              ))}
            </div>

            <div class="src-foot">
              <div class="history" aria-label="最近检测记录">
                {(src.history || []).slice(-42).map((h: any) => (
                  <span
                    class={`hist-cell is-${h.status}`}
                    title={`${fmtFull(h.at)} · ${statusMeta[h.status]?.label ?? h.status} · ${h.ok}/${h.tested} 平台`}
                  />
                ))}
              </div>
              <span class="history-label">
                最近 {Math.min((src.history || []).length, 42)} 次 · {src.stats?.ok ?? 0}/{src.stats?.tested ?? 0} 平台
              </span>
            </div>

            {src.initError && (
              <p class="src-error"><b>初始化失败</b>{src.initError}</p>
            )}

            {failed.length > 0 && (
              <details class="src-details">
                <summary>查看 {failed.length} 个平台的失败原因</summary>
                <ul>
                  {failed.map((p: any) => (
                    <li><b>{p.name}</b><span>{p.error || "请求失败"}</span></li>
                  ))}
                </ul>
              </details>
            )}
          </article>
        );
      })}

      <div class="empty-state" id="empty-state" hidden>
        <h2>没有匹配的音源</h2>
        <p>换一个关键词，或调整上方的筛选条件。</p>
      </div>
    </section>

    <section class="container status-notes" id="how-it-works">
      <h2>检测是怎么做的？</h2>
      <ol>
        <li><b>加载音源</b>：本地脚本直接读取；在线音源先从链接下载最新版本，直连失败时自动改走镜像。</li>
        <li><b>请求取流</b>：对每个支持的平台，用固定测试歌曲调用音源的 <code>musicUrl</code> 接口。</li>
        <li><b>校验地址</b>：对返回的播放地址发起 Range 请求，确认能拿到音频数据而非错误页。</li>
        <li><b>定时执行</b>：GitHub Actions 每 4 小时运行一次，结果自动提交并触发本站重新构建。</li>
      </ol>
      <p class="notes-foot">
        检测结果受音源上游接口、歌曲版权与网络环境影响，单次失败不代表音源永久不可用；建议结合最近多次记录判断。
      </p>
    </section>
