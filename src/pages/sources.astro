  <script>
    const state = { status: "available", query: "" };
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".src-card"));
    const resultCount = document.getElementById("result-count");
    const emptyState = document.getElementById("empty-state");

    const applyFilters = () => {
      let visible = 0;
      for (const card of cards) {
        const cardStatus = card.dataset.status || "";
        // 「部分可用」合并进「可用」筛选
        const matchStatus =
          state.status === "all" ||
          cardStatus === state.status ||
          (state.status === "available" && cardStatus === "partial");
        const matchQuery = !state.query || (card.dataset.search || "").includes(state.query);
        const show = matchStatus && matchQuery;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (resultCount) resultCount.textContent = String(visible);
      if (emptyState) emptyState.hidden = visible > 0;
    };

    document.querySelectorAll<HTMLButtonElement>("[data-filter-status]").forEach((button) => {
      button.addEventListener("click", () => {
        document.querySelectorAll("[data-filter-status]").forEach((el) => el.classList.remove("is-active"));
        button.classList.add("is-active");
        state.status = button.dataset.filterStatus || "all";
        applyFilters();
      });
    });

    const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
    let searchTimer: number | undefined;
    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.query = searchInput.value.trim().toLowerCase();
        applyFilters();
      }, 120);
    });

    const copyText = async (text: string) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const area = document.createElement("textarea");
      area.value = text;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();
      document.execCommand("copy");
      area.remove();
    };

    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((button) => {
      button.addEventListener("click", async () => {
        const sourcePath = button.dataset.sourcePath || "";
        if (!sourcePath) {
          button.title = "暂无可用链接";
          return;
        }
        // 相对路径补成完整地址，方便直接粘贴到音乐 App
        const url = new URL(sourcePath, window.location.origin).toString();
        try {
          await copyText(url);
          button.classList.add("is-copied");
          button.title = "已复制";
          window.setTimeout(() => {
            button.classList.remove("is-copied");
            button.title = "复制音源链接";
          }, 1500);
        } catch {
          button.title = "复制失败，请手动复制";
        }
      });
    });

    // 下载按钮：先 fetch 成 blob 再触发保存，绕开跨域下 download 属性失效的问题；
    // 拉取失败（无 CORS 或网络异常）时退回浏览器原生打开，用户可长按保存
    document.querySelectorAll<HTMLAnchorElement>(".download-btn").forEach((link) => {
      link.addEventListener("click", async (event) => {
        const url = link.getAttribute("href") || "";
        if (!url) return;
        event.preventDefault();
        const filename = link.dataset.downloadName || "source.js";
        try {
          const res = await fetch(url, { mode: "cors" });
          if (!res.ok) throw new Error(String(res.status));
          const blob = await res.blob();
          const objectUrl = URL.createObjectURL(blob);
          const saver = document.createElement("a");
          saver.href = objectUrl;
          saver.download = filename;
          document.body.appendChild(saver);
          saver.click();
          saver.remove();
          window.setTimeout(() => URL.revokeObjectURL(objectUrl), 4000);
          link.classList.add("is-copied");
          link.title = "已开始下载";
          window.setTimeout(() => {
            link.classList.remove("is-copied");
            link.title = "下载音源脚本";
          }, 1500);
        } catch {
          window.open(url, "_blank", "noopener");
        }
      });
    });

    // ---- 合并音源：复制订阅地址 / 全部链接（取构建期生成的公开文件） ----
const mergedStatus = document.getElementById("merged-status");
const setMergedStatus = (text: string) => {
  if (mergedStatus) mergedStatus.textContent = text;
};
const fetchMergedText = async () => {
  const res = await fetch("/merged-sources.txt", { cache: "no-cache" });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.text();
};
document.getElementById("copy-merged-json")?.addEventListener("click", async (event) => {
  const button = event.currentTarget as HTMLButtonElement;
  try {
    await copyText(button.dataset.copyUrl || "");
    setMergedStatus("已复制订阅地址，粘贴到支持订阅清单的客户端即可。");
  } catch {
    setMergedStatus("复制失败，请手动复制地址栏中的 /merged-sources.json 链接。");
  }
});
document.getElementById("copy-merged-links")?.addEventListener("click", async () => {
  try {
    await copyText(await fetchMergedText());
    setMergedStatus("已复制全部音源链接，一行一个，按通过平台数排序。");
  } catch {
    setMergedStatus("读取合并清单失败，请直接下载 TXT 链接列表。");
  }
});

// ---- 自定义添加音源：仅 localStorage，不执行任何脚本代码 ----
const CUSTOM_KEY = "anheplayer.customSources.v1";
type CustomSource = {
  id: string;
  name: string;
  url: string;
  mirror?: string;
  homepage?: string;
  verified: "unknown" | "reachable" | "unreachable";
  checkedAt?: string;
};
const customForm = document.getElementById("custom-source-form") as HTMLFormElement | null;
const customListEl = document.getElementById("custom-list");
const customStatus = document.getElementById("custom-status");
const customAddBtn = document.getElementById("custom-add-btn") as HTMLButtonElement | null;
const setCustomStatus = (text: string) => {
  if (customStatus) customStatus.textContent = text;
};
const loadCustomSources = (): CustomSource[] => {
  try {
    const parsed = JSON.parse(localStorage.getItem(CUSTOM_KEY) || "[]");
    return Array.isArray(parsed) ? parsed.filter((item) => item && typeof item.url === "string") : [];
  } catch {
    return [];
  }
};
const saveCustomSources = (items: CustomSource[]) => {
  try {
    localStorage.setItem(CUSTOM_KEY, JSON.stringify(items));
  } catch {
    setCustomStatus("浏览器存储已满或被禁用，本次添加无法保存。");
  }
};
let customSources = loadCustomSources();
let builtinUrls = new Set<string>();
fetchMergedText()
  .then((text) => {
    builtinUrls = new Set(text.split("\n").map((line) => line.trim().toLowerCase()).filter(Boolean));
  })
  .catch(() => {
    builtinUrls = new Set();
  });
const normalizeUrl = (value: string) => value.trim().toLowerCase();
const parseHttpsJsUrl = (value: string): URL | null => {
  try {
    const url = new URL(value.trim());
    if (url.protocol !== "https:") return null;
    if (!url.pathname.endsWith(".js")) return null;
    return url;
  } catch {
    return null;
  }
};
const parseHttpsUrl = (value: string): URL | null => {
  if (!value.trim()) return null;
  try {
    const url = new URL(value.trim());
    return url.protocol === "https:" ? url : null;
  } catch {
    return null;
  }
};
const downloadBlob = (filename: string, text: string, type: string) => {
  const blob = new Blob([text], { type });
  const objectUrl = URL.createObjectURL(blob);
  const saver = document.createElement("a");
  saver.href = objectUrl;
  saver.download = filename;
  document.body.appendChild(saver);
  saver.click();
  saver.remove();
  window.setTimeout(() => URL.revokeObjectURL(objectUrl), 4000);
};
const renderCustomSources = () => {
  if (!customListEl) return;
  customListEl.replaceChildren();
  if (customSources.length === 0) {
    const empty = document.createElement("p");
    empty.className = "panel-note";
    empty.textContent = "还没有自定义音源。添加后会在这里显示，刷新页面也不会丢（只存在本机浏览器）。";
    customListEl.appendChild(empty);
    return;
  }
  for (const item of customSources) {
    const card = document.createElement("article");
    card.className = "custom-card";
    const head = document.createElement("div");
    head.className = "custom-card-head";
    const nameEl = document.createElement("b");
    nameEl.textContent = item.name;
    const badge = document.createElement("span");
    badge.className = "tag " + (item.verified === "reachable" ? "tag-ok" : item.verified === "unreachable" ? "tag-bad" : "tag-version");
    badge.textContent = item.verified === "reachable" ? "链接可达" : item.verified === "unreachable" ? "链接不可达" : "未验证";
    head.append(nameEl, badge);
    const link = document.createElement("a");
    link.className = "custom-url";
    link.href = item.url;
    link.target = "_blank";
    link.rel = "noopener";
    link.textContent = item.url;
    const actions = document.createElement("div");
    actions.className = "panel-actions";
    const copyBtn = document.createElement("button");
    copyBtn.type = "button";
    copyBtn.className = "action-btn";
    copyBtn.textContent = "复制链接";
    copyBtn.addEventListener("click", async () => {
      try {
        await copyText(item.url);
        setCustomStatus(`已复制「${item.name}」的链接。`);
      } catch {
        setCustomStatus("复制失败，请长按链接手动复制。");
      }
    });
    const removeBtn = document.createElement("button");
    removeBtn.type = "button";
    removeBtn.className = "action-btn";
    removeBtn.textContent = "删除";
    removeBtn.addEventListener("click", () => {
      customSources = customSources.filter((entry) => entry.id !== item.id);
      saveCustomSources(customSources);
      renderCustomSources();
      setCustomStatus(`已删除「${item.name}」。`);
    });
    actions.append(copyBtn, removeBtn);
    card.append(head, link, actions);
    customListEl.appendChild(card);
  }
  // 提交 Issue 的链接随自定义清单实时生成
  const issueLink = document.getElementById("submit-issue-link") as HTMLAnchorElement | null;
  if (issueLink) {
    const body = customSources
      .map((item) => `- ${item.name}\n  - url: ${item.url}${item.mirror ? `\n  - mirror: ${item.mirror}` : ""}${item.homepage ? `\n  - homepage: ${item.homepage}` : ""}`)
      .join("\n");
    const params = new URLSearchParams({
      title: "新增音源：请检测并收录以下自定义音源",
      body: `请维护者检测以下音源，确认可用后收录到 sources/remote.json 或 sources/ 目录：\n\n${body || "（暂无自定义音源）"}\n`,
    });
    issueLink.href = `https://github.com/raclen/cf-anheplayer/issues/new?${params.toString()}`;
  }
};
const checkLinkReachable = async (url: string): Promise<CustomSource["verified"]> => {
  try {
    const res = await fetch(url, {
      mode: "cors",
      redirect: "follow",
      signal: AbortSignal.timeout(8000),
    });
    if (!res.ok) return "unreachable";
    // 只读文本做“疑似脚本”判断，绝不执行返回的代码。
    const text = await res.text();
    const looksLikeSource =
      text.length > 50 &&
      (text.includes("@name") || text.includes("EVENT_NAMES") || text.includes("musicUrl") || text.includes("globalThis.lx"));
    return looksLikeSource ? "reachable" : "unreachable";
  } catch {
    // 跨域拒绝、网络异常时无法在浏览器里核实，标记为未验证，不谎称失败。
    return "unknown";
  }
};
customForm?.addEventListener("submit", async (event) => {
  event.preventDefault();
  const nameInput = document.getElementById("custom-name") as HTMLInputElement | null;
  const urlInput = document.getElementById("custom-url") as HTMLInputElement | null;
  const mirrorInput = document.getElementById("custom-mirror") as HTMLInputElement | null;
  const homepageInput = document.getElementById("custom-homepage") as HTMLInputElement | null;
  const name = nameInput?.value.trim() || "";
  const url = parseHttpsJsUrl(urlInput?.value || "");
  const mirror = mirrorInput?.value.trim() ? parseHttpsJsUrl(mirrorInput.value) : null;
  const homepage = homepageInput?.value.trim() ? parseHttpsUrl(homepageInput.value) : null;
  if (!name) {
    setCustomStatus("请填写音源名称。");
    nameInput?.focus();
    return;
  }
  if (!url) {
    setCustomStatus("音源链接必须是 https 开头、以 .js 结尾的地址。");
    urlInput?.focus();
    return;
  }
  if (mirrorInput?.value.trim() && !mirror) {
    setCustomStatus("镜像链接也必须是 https 开头、以 .js 结尾的地址。");
    mirrorInput.focus();
    return;
  }
  if (homepageInput?.value.trim() && !homepage) {
    setCustomStatus("主页必须是 https 开头的地址。");
    homepageInput.focus();
    return;
  }
  if (builtinUrls.has(normalizeUrl(url.href))) {
    setCustomStatus("这个链接已经在上面的合并清单里了，不用重复添加。");
    return;
  }
  if (customSources.some((item) => normalizeUrl(item.url) === normalizeUrl(url.href))) {
    setCustomStatus("这个链接已经添加过了。");
    return;
  }
  if (customAddBtn) customAddBtn.disabled = true;
  setCustomStatus("正在检查链接是否能打开…（不执行脚本代码）");
  const verified = await checkLinkReachable(url.href);
  const item: CustomSource = {
    id: typeof crypto !== "undefined" && "randomUUID" in crypto ? crypto.randomUUID() : `custom-${Date.now()}`,
    name,
    url: url.href,
    mirror: mirror?.href,
    homepage: homepage?.href,
    verified,
    checkedAt: new Date().toISOString(),
  };
  customSources = [item, ...customSources];
  saveCustomSources(customSources);
  renderCustomSources();
  customForm.reset();
  if (customAddBtn) customAddBtn.disabled = false;
  setCustomStatus(
    verified === "reachable"
      ? `已添加「${name}」：链接可打开且内容疑似音源脚本（未做拉流检测）。`
      : verified === "unreachable"
        ? `已添加「${name}」，但链接打不开或内容不像音源脚本，请核对地址后重新添加。`
        : `已添加「${name}」，浏览器因跨域无法核实该链接，未验证，仅保存在本机。`,
  );
});
document.getElementById("copy-combined-links")?.addEventListener("click", async () => {
  try {
    const mergedText = await fetchMergedText();
    const seen = new Set(mergedText.split("\n").map((line) => line.trim()).filter(Boolean));
    for (const item of customSources) seen.add(item.url);
    await copyText([...seen].join("\n") + "\n");
    setCustomStatus(`已复制合并清单 + ${customSources.length} 个自定义音源的全部链接。`);
  } catch {
    setCustomStatus("读取合并清单失败，请分别复制上面的合并清单与自定义链接。");
  }
});
document.getElementById("download-custom-json")?.addEventListener("click", () => {
  if (customSources.length === 0) {
    setCustomStatus("还没有自定义音源，先添加一个再下载。");
    return;
  }
  downloadBlob(
    "my-custom-sources.json",
    JSON.stringify(
      {
        sources: customSources.map((item) => ({
          id: item.id,
          name: item.name,
          url: item.url,
          ...(item.mirror ? { mirror: item.mirror } : {}),
          ...(item.homepage ? { homepage: item.homepage } : {}),
        })),
      },
      null,
      2,
    ) + "\n",
    "application/json",
  );
  setCustomStatus("已下载我的音源清单（JSON），换设备时可凭它重新添加。");
});
document.getElementById("copy-submit-snippet")?.addEventListener("click", async () => {
  if (customSources.length === 0) {
    setCustomStatus("还没有自定义音源，先添加一个再复制提交片段。");
    return;
  }
  const snippet = customSources
    .map(
      (item) =>
        `  {\n    "id": "${item.name}",\n    "title": "${item.name}",\n    "category": "在线",\n    "url": "${item.url}"${item.mirror ? `,\n    "mirror": "${item.mirror}"` : ""}${item.homepage ? `,\n    "homepage": "${item.homepage}"` : ""}\n  }`,
    )
    .join(",\n");
  try {
    await copyText(snippet);
    setCustomStatus("已复制 remote.json 提交片段，请把 id 改成英文唯一标识后再提交 PR。");
  } catch {
    setCustomStatus("复制失败，请用 Issue 链接提交。");
  }
});
renderCustomSources();


    applyFilters();
  </script>

