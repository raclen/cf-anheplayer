---
import { PLATFORMS, OS_GROUP, RELEASES_LATEST_URL, type IconKey } from "@/data/platforms";
import { getPcRelease, getMirrorUrl, fmtSize } from "@/data/releases";

const pc = getPcRelease();

// 平台图标（当前仅 Windows）
const osIcons: Record<IconKey, string> = {
  windows:
    '<path d="M0 3.4 10 2v9H0V3.4ZM11 1.8l13-1.8v11H11V1.8ZM0 12.6V20l10 1.4V13H0Zm11 8.6L24 23V12H11v9.2Z"/>',
};

// 预先匹配好各个 platform 的静态数据
const platformData = PLATFORMS.map((p) => {
  const asset = pc.assets.find((a) => a.name.includes(p.match));
  const downloadUrl =
    asset?.downloadUrl ||
    `https://github.com/raclen/AnhePlayer/releases/download/v${pc.version}/AnhePlayer_${pc.version}_${p.file}`;
  const mirrorUrl = getMirrorUrl(downloadUrl);
  const size = asset?.size
    ? fmtSize(asset.size)
    : p.id === "win-setup"
      ? "约 5.0 MB"
      : "约 7.0 MB";
  return {
    ...p,
    downloadUrl,
    mirrorUrl,
    size,
    filename: asset?.name || `AnhePlayer_${pc.version}_${p.file}`,
  };
});
---

<section class="section download-section" id="download">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">立即下载</span>
      <h2 class="section-title">
        选择适合你的<span class="gradient-text">安装包</span>
      </h2>
      <p class="section-desc">
        当前版本专为 Windows 10 / 11 打造，提供一键安装版与 MSI 安装包。国内用户推荐使用「国内高速下载」。
      </p>
    </div>

    <div class="os-group reveal">
      <div class="os-group-header">
        <div class="os-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" set:html={osIcons[OS_GROUP.icon]} />
        </div>
        <div class="os-group-title">
          <h3>{OS_GROUP.label}</h3>
          <span>x64 架构 · Tauri v2 原生应用 · 正式版 v{pc.version}</span>
        </div>
      </div>

      <div class="os-assets">
        {
          platformData.map((p) => (
            <div class="asset-card" data-asset-id={p.id}>
              <div class="asset-info">
                <div class="asset-label-row">
                  <span class="asset-label">
                    {p.label}
                    {p.recommended && <span class="asset-badge">推荐</span>}
                  </span>
                  <span class="asset-size" data-size>{p.size}</span>
                </div>
                <span class="asset-note">{p.note}</span>
                <span class="asset-filename" data-filename>{p.filename}</span>
              </div>
              <div class="asset-actions">
                <a
                  class="btn btn-primary btn-sm btn-mirror"
                  data-mirror-btn
                  href={p.mirrorUrl}
                  target="_blank"
                  rel="noopener"
                  title="通过国内高速镜像通道下载"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>
                  </svg>
                  <span>国内高速下载</span>
                </a>
                <a
                  class="btn btn-secondary btn-sm btn-official"
                  data-official-btn
                  href={p.downloadUrl}
                  target="_blank"
                  rel="noopener"
                  title="GitHub 官方原链下载"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v11m0 0 4-4m-4 4-4-4"/>
                    <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
                  </svg>
                  <span>官方直链</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="download-footer reveal">
      <a class="footer-link" href={RELEASES_LATEST_URL} target="_blank" rel="noopener">
        查看全部历史版本 →
      </a>
      <p class="api-status" id="api-status">
        已就绪最新正式版 v{pc.version}（全网累计 {pc.totalDownloads.toLocaleString()} 次下载）
      </p>
    </div>
  </div>
</section>

<script>
  import { PLATFORMS, LATEST_API } from "@/data/platforms";
  import { getMirrorUrl, fmtSize } from "@/data/releases";

  // 后台尝试静默检测 GitHub API 是否有更新的 Release
  async function checkLatestReleasesQuietly() {
    const status = document.getElementById("api-status");
    const heroVersion = document.getElementById("hero-version");
    const heroBtn = document.getElementById("hero-download-btn") as HTMLAnchorElement | null;
    const heroOfficialBtn = document.getElementById("hero-official-btn") as HTMLAnchorElement | null;

    try {
      const res = await fetch(LATEST_API, { signal: AbortSignal.timeout(6000) });
      if (!res.ok) return; // 限流或失败时直接保留静态预渲染内容
      const data = await res.json();
      const version = data.tag_name;
      if (!version) return;

      const assets = data.assets || [];

      for (const p of PLATFORMS) {
        const asset = assets.find((a: any) => a.name?.includes(p.match));
        const card = document.querySelector<HTMLElement>(`[data-asset-id="${p.id}"]`);
        if (asset && card) {
          const mirrorBtn = card.querySelector<HTMLAnchorElement>("[data-mirror-btn]");
          const officialBtn = card.querySelector<HTMLAnchorElement>("[data-official-btn]");
          const sizeSpan = card.querySelector<HTMLElement>("[data-size]");
          const filenameSpan = card.querySelector<HTMLElement>("[data-filename]");

          if (mirrorBtn) mirrorBtn.href = getMirrorUrl(asset.browser_download_url);
          if (officialBtn) officialBtn.href = asset.browser_download_url;
          if (sizeSpan) sizeSpan.textContent = fmtSize(asset.size || 0);
          if (filenameSpan && asset.name) filenameSpan.textContent = asset.name;
        }
      }

      // 如果有推荐包，刷新 Hero 按钮
      const recommended = PLATFORMS.find((p) => p.recommended);
      const recommendedAsset = assets.find((a: any) => a.name?.includes(recommended?.match || ""));
      if (recommendedAsset) {
        if (heroBtn) {
          heroBtn.href = getMirrorUrl(recommendedAsset.browser_download_url);
          const btnSpan = heroBtn.querySelector("span");
          if (btnSpan) btnSpan.textContent = `国内高速下载 (${version})`;
        }
        if (heroOfficialBtn) {
          heroOfficialBtn.href = recommendedAsset.browser_download_url;
        }
      }

      if (heroVersion) heroVersion.textContent = version;
      if (status) status.textContent = `已连接 GitHub 同步最新版本 ${version}`;
    } catch {
      // 静默处理，静态预渲染的内容已经是正确的最新版
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", checkLatestReleasesQuietly);
  } else {
    checkLatestReleasesQuietly();
  }
</script>

<style>
  .download-section {
    background: var(--surface-soft);
  }

  .os-group {
    max-width: 860px;
    margin-inline: auto;
  }

  .os-group-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .os-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--ink);
  }

  .os-icon svg {
    width: 24px;
    height: 24px;
    color: var(--canvas);
  }

  .os-group-title h3 {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
  }

  .os-group-title span {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.55;
  }

  .os-assets {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .asset-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px;
    border-radius: var(--radius-md);
    background: var(--canvas);
    border: 1px solid var(--hairline);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: var(--shadow-sm);
  }

  .asset-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }

  .asset-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .asset-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .asset-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  .asset-badge {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--block-lime);
  }

  .asset-note {
    font-size: 0.85rem;
    color: var(--ink);
    opacity: 0.65;
  }

  .asset-filename {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--ink);
    opacity: 0.5;
    word-break: break-all;
  }

  .asset-size {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--ink);
    opacity: 0.65;
    white-space: nowrap;
  }

  .asset-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .asset-actions .btn {
    flex: 1;
    min-width: 120px;
    padding: 10px 14px;
    font-size: 0.9rem;
    border-radius: var(--radius-sm);
  }

  .download-footer {
    margin-top: 56px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    transition: opacity 0.2s ease;
  }

  .footer-link:hover {
    opacity: 0.7;
  }

  .api-status {
    font-size: 0.88rem;
    color: var(--ink);
    opacity: 0.5;
  }

  @media (max-width: 680px) {
    .os-assets {
      grid-template-columns: 1fr;
    }

    .asset-actions {
      flex-direction: column;
    }

    .asset-actions .btn {
      width: 100%;
    }
  }
</style>
