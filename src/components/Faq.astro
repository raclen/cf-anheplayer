---
// 常见问题区块：既是给用户看的可折叠问答，也是页面 FAQPage 结构化数据的对应可见内容
import type { FaqItem } from "@/utils/seo";

export interface Props {
  items: FaqItem[];
  title?: string;
  eyebrow?: string;
  desc?: string;
}

const {
  items,
  title = "常见问题",
  eyebrow = "FAQ",
  desc = "关于安装、音源与使用的常见疑问，先看这里。",
} = Astro.props;
---

<section class="section faq-section" id="faq">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">{desc}</p>
    </div>

    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item reveal" open={i === 0} style={`transition-delay: ${i * 40}ms`}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <p class="faq-a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: var(--surface-soft);
  }

  .faq-list {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: var(--canvas);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex: none;
    width: 16px;
    height: 16px;
    position: relative;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transform: translateY(-50%);
    transition: transform 0.2s ease;
  }

  .faq-icon::after {
    transform: translateY(-50%) rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .faq-a {
    margin-top: 12px;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--ink);
    opacity: 0.7;
  }
</style>